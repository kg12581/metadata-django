# 数据库类型: mysql / postgresql
DB_TYPE=mysql
DB_HOST=192.168.3.100
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=mysql
# 只同步指定 schema(库), 留空则同步全部业务库
# DB_SCHEMA=hive_metastore

# Doris FE(走 MySQL 协议, 默认端口 9030)
DORIS_HOST=192.168.3.100
DORIS_PORT=9030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=test_db

# DataX 安装路径, 例如 /opt/datax (bin/datax.py)
DATAX_HOME=
DATAX_PYTHON=python3

# 大模型(默认对接 DeepSeek, OpenAI 兼容; key 申请: https://platform.deepseek.com/)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
